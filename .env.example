# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=tide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tide
DATABASE_URL=postgresql+psycopg://tide:change-me@localhost:5432/tide

# Instance types and regions to price (default: ./catalog.yaml)
CATALOG_PATH=catalog.yaml

# AWS (price collection needs read-only access, see docs/permissions.md).
# Prefer a named CLI profile over access keys.
AWS_PROFILE=
AWS_REGION=ap-south-1

# Azure (not needed for price collection: the Retail Prices API is public).
# Service principal for least-privilege access, used from Phase 6.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
