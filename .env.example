# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=tide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tide
DATABASE_URL=postgresql+psycopg://tide:change-me@localhost:5432/tide

# AWS (used from Phase 2). Prefer a named CLI profile over access keys.
AWS_PROFILE=
AWS_REGION=ap-south-1

# Azure (used from Phase 2). Service principal for least-privilege access.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
